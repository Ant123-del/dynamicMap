rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user has exactly one pacing session doc, keyed by their own uid.
    match /sessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Each user has exactly one pacing-preferences doc, keyed by their own uid.
    match /preferences/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
