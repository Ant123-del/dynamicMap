# Copy this file to .env.local and fill in your Firebase web app config
# (Firebase Console → Project settings → General → Your apps → SDK setup and configuration).
# .env.local is gitignored (matches *.local) — never commit real values.
#
# The same six values must also be set as Environment Variables in your
# Vercel project settings so production builds can reach Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
